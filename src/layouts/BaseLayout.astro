---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../data/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePath: string;
  ogImage?: string;
}

const { lang, title, description, canonicalPath, alternatePath, ogImage = '/images/social-card-v4.webp' } = Astro.props;
const site = Astro.site ?? new URL('https://mogwai911.github.io');
const canonical = new URL(canonicalPath, site);
const alternate = new URL(alternatePath, site);
const absoluteOg = new URL(ogImage, site);
const preloadAtlasFont = lang === 'zh' && canonicalPath === '/';
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f3" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'zh' ? 'en' : 'zh-CN'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadAtlasFont && <link rel="preload" href="/fonts/noto-serif-sc-atlas-700.woff2" as="font" type="font/woff2" crossorigin />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kylian" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#content">{lang === 'zh' ? '跳到正文' : 'Skip to content'}</a>
    <div class="silk-bg" aria-hidden="true">
      <video class="silk-bg__video" muted loop playsinline preload="metadata" poster="/images/silk-poster.webp">
        <source src="/videos/silk-bg.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="cursor-mark" aria-hidden="true"><i></i></div>
    <slot />
    <script>
      const siteWindow = window as Window & {
        __mogwaiSiteCleanup?: () => void;
        __mogwaiSiteInit?: () => void;
      };

      const init = () => {
        siteWindow.__mogwaiSiteCleanup?.();
        const controller = new AbortController();
        const cleanupTasks: Array<() => void> = [];
        const { signal } = controller;
        const body = document.body;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const finePointer = window.matchMedia('(pointer: fine)').matches;
        const trigger = document.querySelector<HTMLElement>('.mobile-menu-trigger');
        const mobileNav = document.querySelector<HTMLElement>('.mobile-nav');
        const setMenu = (open: boolean) => {
          if (!trigger || !mobileNav) return;
          body.classList.toggle('mobile-menu-open', open);
          trigger.setAttribute('aria-expanded', String(open));
          mobileNav.setAttribute('aria-hidden', String(!open));
        };
        trigger?.addEventListener('click', () => setMenu(!body.classList.contains('mobile-menu-open')), { signal });
        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenu(false);
        }, { signal });

        const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
        // Stagger groups: children of a [data-reveal-group] inherit an
        // incremental transition-delay so they cascade as they enter.
        document.querySelectorAll('[data-reveal-group]').forEach((group) => {
          Array.from(group.querySelectorAll<HTMLElement>('[data-reveal]')).forEach((el, i) => {
            el.style.setProperty('--reveal-delay', `${i * 90}ms`);
          });
        });
        if (!reducedMotion && 'IntersectionObserver' in window) {
          body.classList.add('motion-ready');
          // threshold 0: elements hidden by a clip-path reveal report zero
          // intersection area until they become visible, so any positive
          // threshold would never fire for them.
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0, rootMargin: '0px 0px 12% 0px' });
          reveals.forEach((element) => observer.observe(element));
          cleanupTasks.push(() => observer.disconnect());
        } else {
          reveals.forEach((element) => element.classList.add('is-visible'));
        }

        const heroPhoto = document.querySelector<HTMLElement>('[data-photo-drift]');
        if (heroPhoto && !reducedMotion) {
          let ticking = false;
          const updatePhoto = () => {
            const offset = Math.min(window.scrollY * 0.045, 32);
            heroPhoto.style.setProperty('--photo-drift', `${offset}px`);
            ticking = false;
          };
          window.addEventListener('scroll', () => {
            if (!ticking) {
              requestAnimationFrame(updatePhoto);
              ticking = true;
            }
          }, { passive: true, signal });
        }

        const cursor = document.querySelector<HTMLElement>('.cursor-mark');
        if (cursor && finePointer && !reducedMotion) {
          let tx = innerWidth / 2, ty = innerHeight / 2, x = tx, y = ty;
          let cursorFrame = 0;
          const paint = () => {
            x += (tx - x) * 0.2;
            y += (ty - y) * 0.2;
            cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
            cursorFrame = requestAnimationFrame(paint);
          };
          addEventListener('pointermove', (event) => {
            tx = event.clientX;
            ty = event.clientY;
            cursor.classList.add('is-visible');
          }, { passive: true, signal });
          document.addEventListener('pointerover', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const overLink = Boolean(target.closest('a, button'));
            const overMedia = Boolean(target.closest('img, figure, picture, [data-cursor-media]'));
            cursor.classList.toggle('is-over', overLink);
            cursor.classList.toggle('is-media', !overLink && overMedia);
          }, { signal });
          addEventListener('blur', () => cursor.classList.remove('is-visible'), { signal });
          paint();
          cleanupTasks.push(() => cancelAnimationFrame(cursorFrame));
        }

        // Silk background video: ensure playback after page swaps (some
        // browsers pause cloned/hidden videos on SPA navigation). Reduced
        // motion users keep the static poster frame instead.
        const silkVideo = document.querySelector<HTMLVideoElement>('.silk-bg__video');
        if (silkVideo && !reducedMotion) {
          const playSilk = () => silkVideo.play().catch(() => {});
          playSilk();
          // Re-assert on visibility change: tab restore can leave it paused.
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden) playSilk();
          }, { signal });
        }

        siteWindow.__mogwaiSiteCleanup = () => {
          controller.abort();
          cleanupTasks.forEach((cleanup) => cleanup());
        };
      };

      // Re-init on every page swap (View Transitions) so per-page
      // reveals, menu, photo drift and cursor keep working.
      if (siteWindow.__mogwaiSiteInit) {
        document.removeEventListener('astro:page-load', siteWindow.__mogwaiSiteInit);
      }
      siteWindow.__mogwaiSiteInit = init;
      document.addEventListener('astro:page-load', init);
      init();
    </script>
  </body>
</html>
