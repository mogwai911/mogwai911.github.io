---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---
<BaseLayout lang="en" title="404 — Kylian" description="Page not found." canonicalPath="/404.html" alternatePath="/zh/">
  <div class="site-shell">
    <SiteHeader lang="en" alternatePath="/zh/" compact />
    <main id="content" class="not-found">
      <p class="section-label">Lost coordinates</p>
      <h1>404</h1>
      <p>The coordinates lead nowhere.</p>
      <a class="button-link" href="/">Back to Kylian’s home <span>→</span></a>
    </main>
  </div>
</BaseLayout>
